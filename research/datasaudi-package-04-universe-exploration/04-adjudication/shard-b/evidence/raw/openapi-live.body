{"openapi":"3.1.0","info":{"title":"FastAPI","version":"0.1.0"},"paths":{"/_health":{"get":{"summary":"Logiclayer Healthcheck","operationId":"LogicLayer_healthcheck__health_get","responses":{"204":{"description":"Successful Response"}}}},"/tesseract/":{"get":{"summary":"Get module status","description":"Retrieve operational information about this instance of TesseractModule.","operationId":"module_status_tesseract__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ModuleStatus"}}}}}}},"/tesseract/cubes":{"get":{"summary":"List cubes schema","description":"Return the public schema with all the available cubes.","operationId":"get_schema_tesseract_cubes_get","parameters":[{"name":"locale","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Locale"}},{"name":"show_all","in":"query","required":false,"schema":{"type":"boolean","description":"Show all elements including non-visible ones. When false (default), show only visible elements. When true, show all elements.","default":false,"title":"Show All"},"description":"Show all elements including non-visible ones. When false (default), show only visible elements. When true, show all elements."},{"name":"token","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Token"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"x-tesseract-jwt","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Tesseract-Jwt"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TesseractSchema"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tesseract/cubes/{cube_name}":{"get":{"summary":"Get a single cube schema","description":"Return the public schema for the single specified cube.","operationId":"get_cube_tesseract_cubes__cube_name__get","parameters":[{"name":"cube_name","in":"path","required":true,"schema":{"type":"string","title":"Cube Name"}},{"name":"locale","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Locale"}},{"name":"show_all","in":"query","required":false,"schema":{"type":"boolean","description":"Show all elements including non-visible ones. When false (default), show only visible elements. When true, show all elements.","default":false,"title":"Show All"},"description":"Show all elements including non-visible ones. When false (default), show only visible elements. When true, show all elements."},{"name":"token","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Token"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"x-tesseract-jwt","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Tesseract-Jwt"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TesseractCube"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tesseract/data":{"get":{"summary":"Query Data Redirect","description":"Redirect the request to the canonical endpoint in jsonrecords format.","operationId":"query_data_redirect_tesseract_data_get","responses":{"307":{"description":"Successful Response"}},"deprecated":true}},"/tesseract/data.{extension}":{"get":{"summary":"Query data","description":"Execute a request for data from the backend server.","operationId":"query_data_tesseract_data__extension__get","parameters":[{"name":"extension","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ResponseFormat"}},{"name":"cube","in":"query","required":true,"schema":{"type":"string","description":"The name of the cube to work with.","title":"Cube"},"description":"The name of the cube to work with."},{"name":"drilldowns","in":"query","required":true,"schema":{"type":"string","description":"A list of the level names to slice the bulk of the aggregated data.","title":"Drilldowns"},"description":"A list of the level names to slice the bulk of the aggregated data."},{"name":"measures","in":"query","required":true,"schema":{"type":"string","description":"A list of the measure names to retrieve from the aggregated data.","title":"Measures"},"description":"A list of the measure names to retrieve from the aggregated data."},{"name":"alias","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Custom column aliases for levels or measures.\nMatching \"Column ID\" headers are updated automatically when present. Multiple mappings are separated by semicolons (;)\n\nFormat: Column:Alias;Column2:Alias2\n- Column: The exact column label to rename (e.g., \"Exporter Country\", \"Population\")\n- Alias: The new label to use in the response\n\nExamples: \"Exporter Country:Country;Population:Pop","title":"Alias"},"description":"Custom column aliases for levels or measures.\nMatching \"Column ID\" headers are updated automatically when present. Multiple mappings are separated by semicolons (;)\n\nFormat: Column:Alias;Column2:Alias2\n- Column: The exact column label to rename (e.g., \"Exporter Country\", \"Population\")\n- Alias: The new label to use in the response\n\nExamples: \"Exporter Country:Country;Population:Pop"},{"name":"aliases","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Custom column aliases for levels or measures.\nMatching \"Column ID\" headers are updated automatically when present. Multiple mappings are separated by semicolons (;)\n\nFormat: Column:Alias;Column2:Alias2\n- Column: The exact column label to rename (e.g., \"Exporter Country\", \"Population\")\n- Alias: The new label to use in the response\n\nExamples: \"Exporter Country:Country;Population:Pop","deprecated":true,"title":"Aliases"},"description":"Custom column aliases for levels or measures.\nMatching \"Column ID\" headers are updated automatically when present. Multiple mappings are separated by semicolons (;)\n\nFormat: Column:Alias;Column2:Alias2\n- Column: The exact column label to rename (e.g., \"Exporter Country\", \"Population\")\n- Alias: The new label to use in the response\n\nExamples: \"Exporter Country:Country;Population:Pop","deprecated":true},{"name":"locale","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Locale"}},{"name":"limit","in":"query","required":false,"schema":{"type":"string","description":"Controls how many results to return and from which position to start.\n\nFormat: A single number (limit) or two numbers separated by comma (limit,offset)\n- limit: Maximum number of items to return\n- offset: Starting position (0-based index) in the full result set\n\nExamples: \"10\" returns first 10 items, \"10,20\" returns 10 items starting from position 20","default":"0","title":"Limit"},"description":"Controls how many results to return and from which position to start.\n\nFormat: A single number (limit) or two numbers separated by comma (limit,offset)\n- limit: Maximum number of items to return\n- offset: Starting position (0-based index) in the full result set\n\nExamples: \"10\" returns first 10 items, \"10,20\" returns 10 items starting from position 20"},{"name":"parents","in":"query","required":false,"schema":{"type":"string","description":"Include parent level information for drilldown dimensions\n\nOptions:\n- \"true\" or \"1\": Include parents for all drilldowns\n- \"false\" or \"0\": Exclude all parents (default)\n- \"Level1,Level2\": Include parents only for specified levels\n\nExamples: \"true\", \"Country,State\" ","default":"","title":"Parents"},"description":"Include parent level information for drilldown dimensions\n\nOptions:\n- \"true\" or \"1\": Include parents for all drilldowns\n- \"false\" or \"0\": Exclude all parents (default)\n- \"Level1,Level2\": Include parents only for specified levels\n\nExamples: \"true\", \"Country,State\" "},{"name":"properties","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Additional properties to include for each dimension member","title":"Properties"},"description":"Additional properties to include for each dimension member"},{"name":"ranking","in":"query","required":false,"schema":{"type":"string","description":"Add ranking numbers to measures in the results.\n\nOptions:\n- \"true\" or \"1\": Add rankings for all measures\n- \"false\" or \"0\": No rankings (default)\n- \"Measure1,Measure2\": Add rankings only for specified measures\n\nUse \"-\" prefix for descending order: \"-Population\" ranks Population in descending order.\nEqual values get the same rank, with gaps for ties.","default":"","title":"Ranking"},"description":"Add ranking numbers to measures in the results.\n\nOptions:\n- \"true\" or \"1\": Add rankings for all measures\n- \"false\" or \"0\": No rankings (default)\n- \"Measure1,Measure2\": Add rankings only for specified measures\n\nUse \"-\" prefix for descending order: \"-Population\" ranks Population in descending order.\nEqual values get the same rank, with gaps for ties."},{"name":"sort","in":"query","required":false,"schema":{"type":"string","description":"Controls the order of results by measures or properties.\n\nFormat: field or field.order\n- field: Name of the measure or property to sort by\n- order: \"asc\" (ascending) or \"desc\" (descending), defaults to \"asc\" if not specified\n\nThe system first looks for a measure with this name, then for a property.\nExamples: \"Population\", \"Population.desc\", \"Country.asc\" ","default":"","title":"Sort"},"description":"Controls the order of results by measures or properties.\n\nFormat: field or field.order\n- field: Name of the measure or property to sort by\n- order: \"asc\" (ascending) or \"desc\" (descending), defaults to \"asc\" if not specified\n\nThe system first looks for a measure with this name, then for a property.\nExamples: \"Population\", \"Population.desc\", \"Country.asc\" "},{"name":"sparse","in":"query","required":false,"schema":{"type":"boolean","description":"Control whether to return only rows with data or all possible combinations.\n\n- true (default): Return only rows that have at least one non-null measure value\n- false: Return all possible dimension combinations for requested drilldowns (full cardinality). Measures without values will be null.\n\nWarning: Setting to false may return very large datasets, specially when many drilldowns are used.","default":true,"title":"Sparse"},"description":"Control whether to return only rows with data or all possible combinations.\n\n- true (default): Return only rows that have at least one non-null measure value\n- false: Return all possible dimension combinations for requested drilldowns (full cardinality). Measures without values will be null.\n\nWarning: Setting to false may return very large datasets, specially when many drilldowns are used."},{"name":"time","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter data by time periods using various restriction types.\n\nFormat: level.constraint\n- level: Time dimension level name as defined in the cube (e.g., \"Year\", \"Month\") or time scale (\"year\", \"quarter\", \"month\", \"day\")\n- constraint: Time restriction type with parameters\n\nConstraint types (periods are defined by the time dimension level):\n- `complete`: Return all available time periods (only for \"year\" and \"quarter\" scales)\n- `latest.N`: Return the N most recent records, regardless of time continuity (e.g., \"latest.5\" for last 5 records)\n- `oldest.N`: Return the N earliest records, regardless of time continuity (e.g., \"oldest.3\" for first 3 records)\n- `trailing.N`: Return the records available in the last N periods (e.g., \"trailing.12\" for records within the last 12 periods)\n- `leading.N`: Return the records available in the first N periods (e.g., \"leading.3\" for records within the first 3 periods)\n- expr.condition: Custom time filtering using comparison operators (e.g., \"gt.2020\", \"gte.2020.and.lt.2022\")\n\nExamples: `Year.latest.5` (last 5 years), `Month.trailing.12` (last 12 months), `Quarter.complete` (all quarters)","title":"Time"},"description":"Filter data by time periods using various restriction types.\n\nFormat: level.constraint\n- level: Time dimension level name as defined in the cube (e.g., \"Year\", \"Month\") or time scale (\"year\", \"quarter\", \"month\", \"day\")\n- constraint: Time restriction type with parameters\n\nConstraint types (periods are defined by the time dimension level):\n- `complete`: Return all available time periods (only for \"year\" and \"quarter\" scales)\n- `latest.N`: Return the N most recent records, regardless of time continuity (e.g., \"latest.5\" for last 5 records)\n- `oldest.N`: Return the N earliest records, regardless of time continuity (e.g., \"oldest.3\" for first 3 records)\n- `trailing.N`: Return the records available in the last N periods (e.g., \"trailing.12\" for records within the last 12 periods)\n- `leading.N`: Return the records available in the first N periods (e.g., \"leading.3\" for records within the first 3 periods)\n- expr.condition: Custom time filtering using comparison operators (e.g., \"gt.2020\", \"gte.2020.and.lt.2022\")\n\nExamples: `Year.latest.5` (last 5 years), `Month.trailing.12` (last 12 months), `Quarter.complete` (all quarters)"},{"name":"top","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Return only the top/bottom results grouped by specified levels.\n\nFormat: amount.level[,level...].measure.order\n- amount: Number of top/bottom results to return (integer > 0)\n- level[,level...]: One or more levels to group by (comma-separated)\n- measure: The measure to rank by\n- order: \"desc\" for top results, \"asc\" for bottom results\n\nExamples: `10.Country.Population.desc` (top 10 countries by population) or `5.State,City.Sales.asc` (bottom 5 state-city combinations by sales)\n\nThis groups the data by the specified levels, then returns only the top or bottom results based on the measure value.","title":"Top"},"description":"Return only the top/bottom results grouped by specified levels.\n\nFormat: amount.level[,level...].measure.order\n- amount: Number of top/bottom results to return (integer > 0)\n- level[,level...]: One or more levels to group by (comma-separated)\n- measure: The measure to rank by\n- order: \"desc\" for top results, \"asc\" for bottom results\n\nExamples: `10.Country.Population.desc` (top 10 countries by population) or `5.State,City.Sales.asc` (bottom 5 state-city combinations by sales)\n\nThis groups the data by the specified levels, then returns only the top or bottom results based on the measure value."},{"name":"growth","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Calculate growth rates for measures over time.\n\nFormat: time_level.measure.params\n- time_level: The time dimension level (e.g., \"Year\", \"Month\", \"Quarter\")\n- measure: The measure to calculate growth for\n- params: Either `fixed.member_id` (compare to specific time period) or `period.amount` (compare consecutive periods)\n\nExamples: `Year.Population.fixed.2020` (growth compared to 2020) or `Month.Sales.period.1` (month-over-month growth)\n\nThis adds period difference and growth percentage columns showing the change in measure values over time.","title":"Growth"},"description":"Calculate growth rates for measures over time.\n\nFormat: time_level.measure.params\n- time_level: The time dimension level (e.g., \"Year\", \"Month\", \"Quarter\")\n- measure: The measure to calculate growth for\n- params: Either `fixed.member_id` (compare to specific time period) or `period.amount` (compare consecutive periods)\n\nExamples: `Year.Population.fixed.2020` (growth compared to 2020) or `Month.Sales.period.1` (month-over-month growth)\n\nThis adds period difference and growth percentage columns showing the change in measure values over time."},{"name":"exclude","in":"query","required":false,"schema":{"type":"string","description":"Specifies which dimension members to exclude from the results.\n\nFormat: LevelName:member1,member2;LevelName2:member3,member4\n- LevelName: The name of the dimension level\n- member1,member2: Comma-separated list of member IDs to exclude\n\nExamples: `Country:XX,YY` or `Year:2020;Country:XX,YY`","default":"","title":"Exclude"},"description":"Specifies which dimension members to exclude from the results.\n\nFormat: LevelName:member1,member2;LevelName2:member3,member4\n- LevelName: The name of the dimension level\n- member1,member2: Comma-separated list of member IDs to exclude\n\nExamples: `Country:XX,YY` or `Year:2020;Country:XX,YY`"},{"name":"include","in":"query","required":false,"schema":{"type":"string","description":"Specifies which dimension members to include in the results.\n\nFormat: LevelName:member1,member2;LevelName2:member3,member4\n- LevelName: The name of the dimension level\n- member1,member2: Comma-separated list of member IDs to include\n\nExamples: `Country:US,CA,MX` or `Year:2020,2021;Country:US,CA`\n\nFor backward compatibility, you can also use the level name directly as a parameter:\n`&Country=US,CA,MX` is equivalent to `&include=Country:US,CA,MX`.\nThis is not recommended though, as it may cause confusion.","default":"","title":"Include"},"description":"Specifies which dimension members to include in the results.\n\nFormat: LevelName:member1,member2;LevelName2:member3,member4\n- LevelName: The name of the dimension level\n- member1,member2: Comma-separated list of member IDs to include\n\nExamples: `Country:US,CA,MX` or `Year:2020,2021;Country:US,CA`\n\nFor backward compatibility, you can also use the level name directly as a parameter:\n`&Country=US,CA,MX` is equivalent to `&include=Country:US,CA,MX`.\nThis is not recommended though, as it may cause confusion."},{"name":"filters","in":"query","required":false,"schema":{"type":"array","items":{"type":"string"},"description":"Apply filters to measure values in the results.\n\nFormat: measure.operator.value or measure.operator1.value1.logic.operator2.value2\n- measure: Name of the measure to filter\n- operator: gt, gte, eq, neq, lt, lte (comparisons) or in, nin (membership) or isnull, notnull (nullability)\n- value: Numeric value for comparisons, list for membership, none for nullability\n- logic: \"and\", \"or\", \"xor\" (to combine multiple conditions)\n\nExamples:\n- `Population.gt.1000000`\n- `Sales.gte.1000.and.lt.5000`\n- `Revenue.in.100,200,300`\n- `Profit.isnull`","default":[],"title":"Filters"},"description":"Apply filters to measure values in the results.\n\nFormat: measure.operator.value or measure.operator1.value1.logic.operator2.value2\n- measure: Name of the measure to filter\n- operator: gt, gte, eq, neq, lt, lte (comparisons) or in, nin (membership) or isnull, notnull (nullability)\n- value: Numeric value for comparisons, list for membership, none for nullability\n- logic: \"and\", \"or\", \"xor\" (to combine multiple conditions)\n\nExamples:\n- `Population.gt.1000000`\n- `Sales.gte.1000.and.lt.5000`\n- `Revenue.in.100,200,300`\n- `Profit.isnull`"},{"name":"token","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Token"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"x-tesseract-jwt","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Tesseract-Jwt"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tesseract/multiquery.{extension}":{"post":{"summary":"Join multiple queries","description":"Execute a request for joining data from the server.","operationId":"multiquery_data_tesseract_multiquery__extension__post","parameters":[{"name":"extension","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ResponseFormat"}},{"name":"token","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Token"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"x-tesseract-jwt","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Tesseract-Jwt"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DataMultiRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tesseract/members.{extension}":{"get":{"summary":"Get Members Redirect","description":"Redirect the request to the canonical endpoint without extension.","operationId":"get_members_redirect_tesseract_members__extension__get","deprecated":true,"parameters":[{"name":"extension","in":"path","required":true,"schema":{"type":"string","title":"Extension"}}],"responses":{"307":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tesseract/members":{"get":{"summary":"Get level members","description":"Retrieve detailed information about a level and its members.","operationId":"get_members_tesseract_members_get","parameters":[{"name":"cube","in":"query","required":true,"schema":{"type":"string","description":"The name of the cube to work with.","title":"Cube"},"description":"The name of the cube to work with."},{"name":"level","in":"query","required":true,"schema":{"type":"string","description":"The name of the level to get the members from.","title":"Level"},"description":"The name of the level to get the members from."},{"name":"locale","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The locale to get the members labels in.","title":"Locale"},"description":"The locale to get the members labels in."},{"name":"limit","in":"query","required":false,"schema":{"type":"string","description":"Controls how many results to return and from which position to start.\n\nFormat: A single number (limit) or two numbers separated by comma (limit,offset)\n- limit: Maximum number of items to return\n- offset: Starting position (0-based index) in the full result set\n\nExamples: \"10\" returns first 10 items, \"10,20\" returns 10 items starting from position 20","default":"0","title":"Limit"},"description":"Controls how many results to return and from which position to start.\n\nFormat: A single number (limit) or two numbers separated by comma (limit,offset)\n- limit: Maximum number of items to return\n- offset: Starting position (0-based index) in the full result set\n\nExamples: \"10\" returns first 10 items, \"10,20\" returns 10 items starting from position 20"},{"name":"parents","in":"query","required":false,"schema":{"type":"boolean","description":"Include parent level information for the selected level.","default":false,"title":"Parents"},"description":"Include parent level information for the selected level."},{"name":"properties","in":"query","required":false,"schema":{"type":"array","items":{"type":"string"},"description":"The Properties to get for each of the members in the selected level.","default":[],"title":"Properties"},"description":"The Properties to get for each of the members in the selected level."},{"name":"search","in":"query","required":false,"schema":{"type":"string","description":"Case-insensitive substring search over member key or caption.","default":"","title":"Search"},"description":"Case-insensitive substring search over member key or caption."},{"name":"token","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Token"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"x-tesseract-jwt","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Tesseract-Jwt"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MembersResponseModel"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"summary":"Route Index","operationId":"route_index__get","responses":{"302":{"description":"Successful Response"}}}}},"components":{"schemas":{"Comparison":{"type":"string","enum":["gt","gte","lt","lte","eq","neq"],"title":"Comparison","description":"Defines the available comparison operations."},"CutIntent":{"properties":{"level":{"type":"string","title":"Level"},"include_members":{"items":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"number"},{"type":"boolean"}]},"type":"array","uniqueItems":true,"title":"Include Members"},"exclude_members":{"items":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"number"},{"type":"boolean"}]},"type":"array","uniqueItems":true,"title":"Exclude Members"}},"type":"object","required":["level","include_members","exclude_members"],"title":"CutIntent","description":"Filtering instructions for a qualitative value.\n\nInstances of this class are used to define cut parameters.\nIts values are directly inputted by the user, so should never be considered\nvalid by itself."},"DataMultiRequest":{"properties":{"requests":{"items":{"$ref":"#/components/schemas/DataRequest"},"type":"array","title":"Requests"},"joins":{"items":{"$ref":"#/components/schemas/JoinIntent"},"type":"array","title":"Joins"},"pagination":{"$ref":"#/components/schemas/PaginationIntent"}},"type":"object","required":["requests"],"title":"DataMultiRequest"},"DataRequest":{"properties":{"cube":{"type":"string","title":"Cube"},"drilldowns":{"items":{"type":"string"},"type":"array","uniqueItems":true,"title":"Drilldowns"},"measures":{"items":{"type":"string"},"type":"array","uniqueItems":true,"title":"Measures"},"aliases":{"additionalProperties":{"type":"string"},"type":"object","title":"Aliases"},"captions":{"items":{"type":"string"},"type":"array","uniqueItems":true,"title":"Captions"},"cuts":{"additionalProperties":{"$ref":"#/components/schemas/CutIntent"},"type":"object","title":"Cuts"},"filters":{"additionalProperties":{"$ref":"#/components/schemas/FilterIntent"},"type":"object","title":"Filters"},"locale":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Locale"},"options":{"additionalProperties":{"type":"boolean"},"type":"object","title":"Options"},"pagination":{"$ref":"#/components/schemas/PaginationIntent"},"parents":{"anyOf":[{"type":"boolean"},{"items":{"type":"string"},"type":"array","uniqueItems":true}],"title":"Parents","default":false},"properties":{"items":{"type":"string"},"type":"array","uniqueItems":true,"title":"Properties"},"ranking":{"anyOf":[{"type":"boolean"},{"additionalProperties":{"type":"string","enum":["asc","desc"]},"type":"object"}],"title":"Ranking","default":false},"roles":{"items":{"type":"string"},"type":"array","uniqueItems":true,"title":"Roles"},"sorting":{"anyOf":[{"$ref":"#/components/schemas/SortingIntent"},{"type":"null"}]},"sparse":{"type":"boolean","title":"Sparse","default":true},"time_restriction":{"anyOf":[{"$ref":"#/components/schemas/TimeRestriction"},{"type":"null"}]},"topk":{"anyOf":[{"$ref":"#/components/schemas/TopkIntent"},{"type":"null"}]},"growth":{"anyOf":[{"$ref":"#/components/schemas/GrowthIntent"},{"type":"null"}]}},"type":"object","required":["cube","drilldowns","measures"],"title":"DataRequest","description":"Represents the intent for a Data Query made by the user.\n\nAll its properties are defined by strings of the names of the components\nfrom the schema.\nNone of these parameters are verified during construction, so it's possible\nfor the query to be invalid; a subclass of :class:`backend.exceptions.BackendError`\nwill be raised in that case.\nThe only purpose of this structure is containing and passing over the query\nintent to the internals.\n\nDuring a request, a :class:`Query` instance is constructed with objects from\na schema, using parameters from this instance."},"DataType":{"type":"string","enum":["bool","date","time","dttm","stmp","f32","f64","i8","i16","i32","i64","i128","u8","u16","u32","u64","u128","str"],"title":"DataType","description":"Types of the data the user can expect to find in the associated column."},"DimensionType":{"type":"string","enum":["standard","time","geo"],"title":"DimensionType","description":"Kind of data a dimension is storing."},"FilterIntent":{"properties":{"field":{"type":"string","title":"Field"},"condition":{"anyOf":[{"prefixItems":[{"type":"integer","const":1},{"$ref":"#/components/schemas/Comparison"},{"type":"string"}],"type":"array","maxItems":3,"minItems":3},{"prefixItems":[{"type":"integer","const":2},{"$ref":"#/components/schemas/Comparison"},{"type":"number"}],"type":"array","maxItems":3,"minItems":3},{"prefixItems":[{"type":"integer","const":3},{"$ref":"#/components/schemas/Membership"},{"anyOf":[{"items":{"type":"string"},"type":"array"},{"items":{"type":"string"},"type":"array","uniqueItems