{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventLive City Places (destination layer)",
  "description": "Data model for EVENTME-CITY-PROFILES-BRIEF.md's city profiles feature. Validated by scripts/validate-city-places.mjs, which layers additional rules this schema cannot express (source-field completeness by origin type, cross-city id uniqueness, Saudi Arabia coordinate bounding box) on top of the structural checks below.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "cities"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["city_slug", "intro_ar", "intro_en", "places"],
        "properties": {
          "city_slug": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9\\u0600-\\u06FF-]+$" },
          "intro_ar": { "type": "string", "minLength": 1 },
          "intro_en": { "type": "string", "minLength": 1 },
          "places": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "name_ar", "name_en", "category", "description_ar", "description_en",
                "coordinates", "source", "status", "last_verified"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
                "name_ar": { "type": "string", "minLength": 1 },
                "name_en": { "type": "string", "minLength": 1 },
                "category": { "type": "string", "enum": ["nature", "culture", "entertainment", "adventure", "food"] },
                "description_ar": { "type": "string", "minLength": 1 },
                "description_en": { "type": "string", "minLength": 1 },
                "coordinates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lat", "lon"],
                  "properties": {
                    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                    "lon": { "type": "number", "minimum": -180, "maximum": 180 }
                  }
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["origin", "source_id", "retrieved_at", "license"],
                  "properties": {
                    "origin": { "type": "string", "enum": ["wikidata", "osm", "moc", "editorial"] },
                    "source_id": { "type": "string", "minLength": 1 },
                    "retrieved_at": { "type": "string", "format": "date-time" },
                    "license": { "type": "string", "enum": ["CC0", "ODbL", "SDAIA-open", "n/a"] }
                  }
                },
                "official_link": { "type": "string" },
                "status": { "type": "string", "enum": ["draft", "reviewed", "published"] },
                "last_verified": { "type": "string", "format": "date" }
              }
            }
          }
        }
      }
    }
  }
}
