{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventLive Discovery Catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generated_for": { "type": "string" },
    "notes": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "organizer",
          "city",
          "venue",
          "category",
          "raw_category",
          "starts_at",
          "ends_at",
          "updated_at",
          "sessions_count",
          "source_label",
          "source_confidence",
          "approval_status",
          "live_schedule_ready"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "program_title": { "type": "string" },
          "organizer": { "type": "string", "minLength": 1 },
          "organizer_name": { "type": "string" },
          "organizer_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "performers": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "enum": ["person", "group", "organization"] },
                    "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
                  }
                }
              ]
            }
          },
          "city": { "type": "string", "minLength": 1 },
          "venue": { "type": "string", "minLength": 1 },
          "venue_address": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "exhibitions-conferences",
              "family-entertainment",
              "culture-arts",
              "education-training",
              "technology-innovation",
              "sports-outdoors",
              "tourism-experiences",
              "business-entrepreneurship",
              "health-regulation",
              "community-occasions"
            ]
          },
          "raw_category": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "rich_summary": { "type": "string" },
          "description": { "type": "string" },
          "program_outline": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string" },
              "source_method": { "type": "string" },
              "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
              "collected_at": { "type": "string", "format": "date-time" },
              "official_description": { "type": "string" },
              "duration_text": { "type": "string" },
              "registration_deadline": { "type": "string" },
              "goals": {
                "type": "array",
                "items": { "type": "string" }
              },
              "features": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requirements": {
                "type": "array",
                "items": { "type": "string" }
              },
              "faqs": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          },
          "image_url": {
            "type": "string",
            "anyOf": [
              { "format": "uri", "pattern": "^https?://" },
              { "pattern": "^/assets/event-(?:images|covers)/[^\"'<>\\s]+$" }
            ]
          },
          "original_image_url": {
            "type": "string",
            "anyOf": [
              { "format": "uri", "pattern": "^https?://" },
              { "pattern": "^/assets/event-(?:images|covers)/[^\"'<>\\s]+$" }
            ]
          },
          "image_alt": { "type": "string" },
          "image_source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "image_discovered_at": { "type": "string", "format": "date-time" },
          "image_discovery_method": {
            "type": "string",
            "enum": ["meta", "json-ld", "catalog-candidate", "img", "srcset"]
          },
          "image_identity_struck_at": { "type": "string", "format": "date-time" },
          "image_identity_strike_reason": {
            "type": "string",
            "enum": ["slot-vacated", "identity-mismatch"]
          },
          "registration_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "ticket_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "registration_status": { "type": "string" },
          "ticket_status": { "type": "string" },
          "offer_valid_from": { "type": "string", "format": "date-time" },
          "attendance_mode": {
            "type": "string",
            "enum": ["online", "in-person", "hybrid"]
          },
          "price_label": { "type": "string" },
          "parking_info": { "type": "string" },
          "accessibility_info": { "type": "string" },
          "age_policy": { "type": "string" },
          "duration_label": { "type": "string" },
          "language": { "type": "string" },
          "registration_deadline": { "type": "string" },
          "richness_score": { "type": "integer", "minimum": 0 },
          "highlights": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "students",
                "job-seekers",
                "professionals",
                "tech",
                "skilled-trades",
                "entrepreneurs",
                "researchers",
                "families",
                "women",
                "creatives",
                "sports",
                "general"
              ]
            },
            "uniqueItems": true
          },
          "starts_at": { "type": "string", "format": "date-time" },
          "event_start": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" },
          "event_end": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "sessions_count": { "type": "integer", "minimum": 0 },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "starts_at", "ends_at"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string", "minLength": 1 },
                "starts_at": { "type": "string", "format": "date-time" },
                "ends_at": { "type": "string", "format": "date-time" },
                "session_type": { "type": "string" },
                "room": { "type": "string" },
                "speaker": { "type": "string" },
                "track": { "type": "string" },
                "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" }
              }
            }
          },
          "tracks_count": { "type": "integer", "minimum": 0 },
          "rooms_count": { "type": "integer", "minimum": 0 },
          "live_updates_count": { "type": "integer", "minimum": 0 },
          "linked_live_updates_count": { "type": "integer", "minimum": 0 },
          "source_label": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "evidence_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "source_confidence": {
            "type": "string",
            "enum": [
              "approved-source",
              "corroborated-source",
              "organizer-confirmed",
              "needs-organizer-confirmation",
              "needs-source-evidence",
              "pending-review",
              "sample-record"
            ]
          },
          "approval_status": {
            "type": "string",
            "enum": ["draft", "reviewed", "approved", "published"]
          },
          "published_by": { "type": "string" },
          "live_schedule_ready": { "type": "boolean" },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "share_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "signage_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "print_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "maps_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "directions_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "source_file": { "type": "string" }
        }
      }
    }
  },
  "required": ["events"]
}
